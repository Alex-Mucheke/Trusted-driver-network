# --- Core ---
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:57511@Alex@localhost:5432/tdn?schema=public"
JWT_SECRET="trusted-driver-network-dev-secret-2026"
JWT_EXPIRES_IN=7d

# --- Web / cookies ---
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend, used to build driver share links
APP_URL=http://localhost:5173
# lax (same-site deployment, recommended) | none (cross-site; requires HTTPS + CSRF protection)
COOKIE_SAMESITE=lax

# --- Booking & referral rules (decisions to lock before the pilot) ---
BOOKING_REQUEST_TTL_MINUTES=15
REFERRAL_TTL_MINUTES=10
MAX_REFERRAL_ATTEMPTS=3
# Indicative fare used for server-side estimates (KES)
BASE_FARE_KES=100
PER_KM_KES=50
# A candidate driver may re-quote within [0.5x, MAX_QUOTE_MULTIPLIER x] of the estimate
MAX_QUOTE_MULTIPLIER=1.5

# --- Location ---
LOCATION_RETENTION_MINUTES=60
LOCATION_MIN_INTERVAL_MS=2000

# --- Payments ---
# Shared secret the M-Pesa callback proxy must send in the x-callback-secret header
MPESA_CALLBACK_SECRET="change-me"

# --- Seed ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=57511@Alex!
SEED_DEMO=true
